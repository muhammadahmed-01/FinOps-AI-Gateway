# LangSmith (required for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=finops-ai-gateway

# EU LangSmith tenants: use the API URL (not the dashboard URL)
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# Postgres + pgvector (Docker)
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=finops
POSTGRES_PORT=5433
DATABASE_URL=postgresql://finops:finops@localhost:5433/finops
INGEST_MAX_PAGES=25

# Smoke test LLM — pick a free-friendly provider (default: ollama)
# Options: ollama | groq | openai | anthropic
SMOKE_LLM_PROVIDER=ollama

# Ollama (free, local — install from https://ollama.com then: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
# Embeddings for ingestion/retrieval
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# Groq (free cloud API key — https://console.groq.com)
# SMOKE_LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (paid API credits required beyond ChatGPT free tier)
# SMOKE_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Anthropic (paid API credits required beyond claude.ai free tier)
# SMOKE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Milestone 2 — hybrid retrieval + cost routing
CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=llama-3.1-8b-instant
ROUTER_SIMPLE_MODEL=qwen3:4b
ROUTER_MEDIUM_MODEL=claude-haiku-4-5
ROUTER_COMPLEX_MODEL=claude-sonnet-4-5
# Cost in Grafana uses Claude list prices (see routing/pricing.py) even when
# Groq answers medium/complex without a real ANTHROPIC_API_KEY (demo mode).

# LLM resilience (timeouts/retries apply to classifier, router, smoke test)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024
CONTEXT_CHAR_BUDGET_PER_CHUNK=1200
METRICS_PORT=9464
PUSHGATEWAY_URL=http://localhost:9091
